datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 41. 多租户与用户模型
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String
  passwordHash     String            @map("password_hash")
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  memberships      WorkspaceMember[]
  agentTasks       AgentTask[]
  analysisSessions AnalysisSession[]

  @@map("users")
}

model Workspace {
  id                       String                     @id @default(uuid())
  name                     String
  slug                     String                     @unique
  defaultMarketplaceId     String?                    @map("default_marketplace_id")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")

  members                  WorkspaceMember[]
  products                 Product[]
  skus                     Sku[]
  suppliers                Supplier[]
  purchaseOrders           PurchaseOrder[]
  orders                   Order[]
  inventoryBalances        InventoryBalance[]
  campaigns                Campaign[]
  reviews                  Review[]
  profitRecords            ProfitDaily[]
  marketResearchProjects   MarketResearchProject[]
  competitors              Competitor[]
  productCompetitors       ProductCompetitor[]
  productOpportunities     ProductOpportunity[]
  vocAnalysisRuns          VocAnalysisRun[]
  listings                 Listing[]
  launchPlans              LaunchPlan[]
  inventorySnapshots       InventorySnapshot[]
  inventoryRecommendations InventoryRecommendation[]
  analysisSessions         AnalysisSession[]
  agentTasks               AgentTask[]
  workflowIdempotencyKeys  WorkflowIdempotency[]
  approvals                Approval[]
  knowledgeDocuments       KnowledgeDocument[]
  evalDatasets             EvalDataset[]
  stores                   Store[]
  commerceAccounts         CommerceAccount[]
  syncRuns                 SyncRun[]
  playbooks                Playbook[]
  playbookRuns             PlaybookRun[]
  commerceFacts            CommerceFact[]
  evidenceItems            EvidenceItem[]
  businessRecommendations  BusinessRecommendation[]
  plannedActions           PlannedAction[]
  actionExecutions         ActionExecution[]
  actionOutcomes           ActionOutcome[]
  simulationState          SimulationState?
  simulationEvents         SimulationEvent[]
  channelDailyMetrics      ChannelDailyMetric[]
  controlWorkspaceRuns     SimulationRun[]            @relation("ControlWorkspaceRuns")
  runWorkspaceRuns         SimulationRun?             @relation("RunWorkspaceRuns")
  controlExperiments       SimulationExperiment[]     @relation("ControlWorkspaceExperiments")

  defaultMarketplace       Marketplace?               @relation(fields: [defaultMarketplaceId], references: [id])

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

// ==========================================
// 42. Marketplace 模型
// ==========================================

model Marketplace {
  id                     String                  @id @default(uuid())
  code                   String                  @unique // e.g. AMAZON_US
  name                   String                  // e.g. Amazon US
  countryCode            String                  @map("country_code")
  currencyCode           String                  @map("currency_code")
  languageCode           String                  @map("language_code")
  timezone               String
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  workspaces             Workspace[]
  products               Product[]
  orders                 Order[]
  campaigns              Campaign[]
  marketResearchProjects MarketResearchProject[]
  competitors            Competitor[]
  listings               Listing[]

  @@map("marketplaces")
}

// ==========================================
// 43. Product / SKU 核心模型
// ==========================================

enum ProductStatus {
  RESEARCHING
  VALIDATED
  DEVELOPING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SkuStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

model Product {
  id                   String               @id @default(uuid())
  workspaceId          String               @map("workspace_id")
  marketplaceId        String               @map("marketplace_id")
  name                 String
  brand                String
  category             String
  subCategory          String?              @map("sub_category")
  status               ProductStatus        @default(RESEARCHING)
  targetPrice          Decimal?             @map("target_price") @db.Decimal(10, 2)
  description          String?
  productBrief         String?              @map("product_brief") @db.Text
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplace          Marketplace          @relation(fields: [marketplaceId], references: [id])
  skus                 Sku[]
  features             ProductFeature[]
  visualFacts          ProductVisualFact[]
  productCompetitors   ProductCompetitor[]
  vocAnalysisRuns      VocAnalysisRun[]
  productOpportunities ProductOpportunity[]

  @@index([workspaceId])
  @@map("products")
}

model Sku {
  id                       String                    @id @default(uuid())
  workspaceId              String                    @map("workspace_id")
  productId                String                    @map("product_id")
  skuCode                  String                    @map("sku_code")
  asin                     String?
  variantName              String                    @map("variant_name")
  color                    String?
  size                     String?
  material                 String?
  weightKg                 Decimal?                  @map("weight_kg") @db.Decimal(8, 3)
  lengthCm                 Decimal?                  @map("length_cm") @db.Decimal(8, 2)
  widthCm                  Decimal?                  @map("width_cm") @db.Decimal(8, 2)
  heightCm                 Decimal?                  @map("height_cm") @db.Decimal(8, 2)
  sellingPrice             Decimal                   @map("selling_price") @db.Decimal(10, 2)
  currencyCode             String                    @default("USD") @map("currency_code")
  status                   SkuStatus                 @default(ACTIVE)
  amazonSellerSku          String?                   @map("amazon_seller_sku")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product                  Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotes                   SupplierSkuQuote[]
  purchaseOrderItems       PurchaseOrderItem[]
  orderItems               OrderItem[]
  inventoryBalances        InventoryBalance[]
  reviews                  Review[]
  profitRecords            ProfitDaily[]
  campaignSkus             CampaignSku[]
  adMetricsDaily           AdMetricDaily[]
  searchTermMetricsDaily   SearchTermMetricDaily[]
  inventorySnapshots       InventorySnapshot[]
  inventoryRecommendations InventoryRecommendation[]
  listings                 Listing[]
  launchPlans              LaunchPlan[]
  analysisSessions         AnalysisSession[]
  agentTasks               AgentTask[]
  simulationEvents         SimulationEvent[]
  channelDailyMetrics      ChannelDailyMetric[]

  @@unique([workspaceId, skuCode])
  @@index([workspaceId])
  @@index([productId])
  @@map("skus")
}

model ProductFeature {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  productId   String   @map("product_id")
  name        String
  value       String
  unit        String?
  featureType String?  @map("feature_type")
  isCore      Boolean  @default(false) @map("is_core")
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([productId])
  @@map("product_features")
}

model ProductVisualFact {
  id                 String   @id @default(uuid())
  workspaceId        String   @map("workspace_id")
  productId          String   @map("product_id")
  imageId            String   @map("image_id")
  imageUrl           String?  @map("image_url")
  type               String   @map("type") // COLOR, SHAPE, COMPONENT, VISIBLE_FEATURE, PACKAGING, USAGE_CONTEXT, OTHER
  value              String   @map("value")
  confidence         Decimal  @default(1.0) @db.Decimal(3, 2)
  status             String   @default("EXTRACTED") // EXTRACTED, CONFIRMED, REJECTED
  evidenceRegionJson String?  @map("evidence_region_json") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([productId])
  @@map("product_visual_facts")
}

// ==========================================
// 44. 市场与竞品模型
// ==========================================

model MarketResearchProject {
  id            String                  @id @default(uuid())
  workspaceId   String                  @map("workspace_id")
  marketplaceId String                  @map("marketplace_id")
  seedKeyword   String                  @map("seed_keyword")
  category      String
  status        String                  @default("COMPLETED")
  startedAt     DateTime                @default(now()) @map("started_at")
  completedAt   DateTime?               @map("completed_at")
  createdBy     String?                 @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at")

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplace   Marketplace             @relation(fields: [marketplaceId], references: [id])
  snapshots     MarketMetricsSnapshot[]
  opportunities ProductOpportunity[]

  @@index([workspaceId])
  @@map("market_research_projects")
}

model MarketMetricsSnapshot {
  id                String                @id @default(uuid())
  researchProjectId String                @map("research_project_id")
  snapshotDate      DateTime              @map("snapshot_date") @db.Date
  searchVolume      Int                   @map("search_volume")
  avgPrice          Decimal               @map("avg_price") @db.Decimal(10, 2)
  avgRating         Decimal               @map("avg_rating") @db.Decimal(3, 2)
  avgReviewCount    Int                   @map("avg_review_count")
  competitorCount   Int                   @map("competitor_count")
  competitionScore  Decimal               @map("competition_score") @db.Decimal(4, 2)
  opportunityScore  Decimal               @map("opportunity_score") @db.Decimal(4, 2)
  rawSource         String?               @map("raw_source")
  createdAt         DateTime              @default(now()) @map("created_at")

  project           MarketResearchProject @relation(fields: [researchProjectId], references: [id], onDelete: Cascade)

  @@index([researchProjectId])
  @@map("market_metrics_snapshots")
}

model Competitor {
  id                 String               @id @default(uuid())
  workspaceId        String               @map("workspace_id")
  marketplaceId      String               @map("marketplace_id")
  asin               String
  brand              String
  title              String
  category           String
  productUrl         String?              @map("product_url")
  imageUrl           String?              @map("image_url")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplace        Marketplace          @relation(fields: [marketplaceId], references: [id])
  snapshots          CompetitorSnapshot[]
  productCompetitors ProductCompetitor[]
  reviews            Review[]

  @@unique([workspaceId, asin])
  @@index([workspaceId])
  @@map("competitors")
}

model ProductCompetitor {
  id           String     @id @default(uuid())
  workspaceId  String     @map("workspace_id")
  productId    String     @map("product_id")
  competitorId String     @map("competitor_id")
  relationType String     @default("DIRECT_BENCHMARK") @map("relation_type")
  isPrimary    Boolean    @default(true) @map("is_primary")
  createdAt    DateTime   @default(now()) @map("created_at")

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([productId, competitorId])
  @@index([workspaceId])
  @@map("product_competitors")
}

model CompetitorSnapshot {
  id               String     @id @default(uuid())
  competitorId     String     @map("competitor_id")
  snapshotDate     DateTime   @map("snapshot_date") @db.Date
  price            Decimal    @db.Decimal(10, 2)
  rating           Decimal    @db.Decimal(3, 2)
  reviewCount      Int        @map("review_count")
  estimatedSales   Int        @map("estimated_sales")
  estimatedRevenue Decimal    @map("estimated_revenue") @db.Decimal(12, 2)
  bsr              Int
  createdAt        DateTime   @default(now()) @map("created_at")

  competitor       Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, snapshotDate])
  @@index([competitorId])
  @@map("competitor_snapshots")
}

// ==========================================
// 45. Review / VOC 模型
// ==========================================

model Review {
  id           String            @id @default(uuid())
  workspaceId  String            @map("workspace_id")
  skuId        String?           @map("sku_id")
  competitorId String?           @map("competitor_id")
  asin         String?
  rating       Int
  title        String?
  content      String            @db.Text
  reviewerName String?           @map("reviewer_name")
  reviewDate   DateTime          @map("review_date")
  isVerified   Boolean           @default(true) @map("is_verified")
  sourceType   String            @default("AMAZON") @map("source_type")
  createdAt    DateTime          @default(now()) @map("created_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku          Sku?              @relation(fields: [skuId], references: [id], onDelete: Cascade)
  competitor   Competitor?       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  topicReviews VocTopicReview[]

  @@index([workspaceId])
  @@index([skuId])
  @@index([competitorId])
  @@map("reviews")
}

model VocAnalysisRun {
  id            String     @id @default(uuid())
  workspaceId   String     @map("workspace_id")
  productId     String     @map("product_id")
  status        String     @default("COMPLETED")
  reviewCount   Int        @map("review_count")
  modelName     String     @default("qwen3.8-max") @map("model_name")
  promptVersion String     @default("v1.0") @map("prompt_version")
  startedAt     DateTime   @default(now()) @map("started_at")
  completedAt   DateTime?  @map("completed_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  topics        VocTopic[]

  @@index([workspaceId])
  @@index([productId])
  @@map("voc_analysis_runs")
}

model VocTopic {
  id            String           @id @default(uuid())
  analysisRunId String           @map("analysis_run_id")
  topicName     String           @map("topic_name")
  topicType     String           @map("topic_type") // PAIN_POINT, PRAISE, FEATURE_REQUEST
  sentiment     String           // POSITIVE, NEGATIVE, NEUTRAL
  reviewCount   Int              @map("review_count")
  percentage    Decimal          @db.Decimal(5, 2)
  severityScore Decimal          @map("severity_score") @db.Decimal(3, 2)
  summary       String           @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")

  analysisRun   VocAnalysisRun   @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  topicReviews  VocTopicReview[]

  @@index([analysisRunId])
  @@map("voc_topics")
}

model VocTopicReview {
  id             String   @id @default(uuid())
  topicId        String   @map("topic_id")
  reviewId       String   @map("review_id")
  relevanceScore Decimal  @map("relevance_score") @db.Decimal(4, 2)
  evidenceText   String   @map("evidence_text") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  topic          VocTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  review         Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([topicId, reviewId])
  @@index([topicId])
  @@index([reviewId])
  @@map("voc_topic_reviews")
}

// ==========================================
// 46. Product Opportunity 模型
// ==========================================

model ProductOpportunity {
  id                     String                 @id @default(uuid())
  workspaceId            String                 @map("workspace_id")
  researchProjectId      String?                @map("research_project_id")
  productId              String?                @map("product_id")
  title                  String
  problemSummary         String                 @map("problem_summary") @db.Text
  targetCustomer         String                 @map("target_customer")
  recommendedPositioning String                 @map("recommended_positioning") @db.Text
  opportunityScore       Decimal                @map("opportunity_score") @db.Decimal(4, 2)
  confidenceLevel        Decimal                @map("confidence_level") @db.Decimal(3, 2)
  evidenceSummary        String                 @map("evidence_summary") @db.Text
  status                 String                 @default("APPROVED") // DRAFT, EVALUATING, APPROVED, REJECTED
  createdAt              DateTime               @default(now()) @map("created_at")

  workspace              Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  researchProject        MarketResearchProject? @relation(fields: [researchProjectId], references: [id])
  product                Product?               @relation(fields: [productId], references: [id])

  @@index([workspaceId])
  @@map("product_opportunities")
}

// ==========================================
// 47. 供应链与采购模型
// ==========================================

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Supplier {
  id             String             @id @default(uuid())
  workspaceId    String             @map("workspace_id")
  name           String
  contactPerson  String?            @map("contact_person")
  email          String?
  phone          String?
  address        String?
  leadTimeDays   Int                @default(15) @map("lead_time_days")
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotes         SupplierSkuQuote[]
  purchaseOrders PurchaseOrder[]

  @@index([workspaceId])
  @@map("suppliers")
}

model SupplierSkuQuote {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  supplierId    String    @map("supplier_id")
  skuId         String    @map("sku_id")
  unitCost      Decimal   @map("unit_cost") @db.Decimal(10, 2)
  moq           Int       @default(1)
  currencyCode  String    @default("USD") @map("currency_code")
  effectiveDate DateTime  @default(now()) @map("effective_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  sku           Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([skuId])
  @@map("supplier_sku_quotes")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  workspaceId          String              @map("workspace_id")
  supplierId           String              @map("supplier_id")
  poNumber             String              @map("po_number")
  status               PurchaseOrderStatus @default(DRAFT)
  totalAmount          Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  currencyCode         String              @default("USD") @map("currency_code")
  orderDate            DateTime            @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?           @map("expected_delivery_date")
  actualDeliveryDate   DateTime?           @map("actual_delivery_date")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  items                PurchaseOrderItem[]

  @@unique([workspaceId, poNumber])
  @@index([workspaceId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  workspaceId      String        @map("workspace_id")
  purchaseOrderId  String        @map("purchase_order_id")
  skuId            String        @map("sku_id")
  quantity         Int
  unitCost         Decimal       @map("unit_cost") @db.Decimal(10, 2)
  receivedQuantity Int           @default(0) @map("received_quantity")
  createdAt        DateTime      @default(now()) @map("created_at")

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku              Sku           @relation(fields: [skuId], references: [id])

  @@index([workspaceId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ==========================================
// 48. Listing 模型
// ==========================================

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Listing {
  id               String           @id @default(uuid())
  workspaceId      String           @map("workspace_id")
  skuId            String           @map("sku_id")
  marketplaceId    String           @map("marketplace_id")
  status           ListingStatus    @default(DRAFT)
  currentVersionId String?          @map("current_version_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku              Sku              @relation(fields: [skuId], references: [id], onDelete: Cascade)
  marketplace      Marketplace      @relation(fields: [marketplaceId], references: [id])
  versions         ListingVersion[]

  @@unique([workspaceId, skuId])
  @@index([workspaceId])
  @@map("listings")
}

model ListingVersion {
  id               String                   @id @default(uuid())
  listingId        String                   @map("listing_id")
  versionNumber    Int                      @map("version_number")
  title            String
  bulletPointsJson String                   @map("bullet_points_json") @db.Text
  description      String                   @db.Text
  searchTerms      String?                  @map("search_terms")
  aPlusCopy        String?                  @map("a_plus_copy") @db.Text
  imageBrief       String?                  @map("image_brief") @db.Text
  imageBriefsJson  String?                  @map("image_briefs_json") @db.Text
  aPlusPlanJson    String?                  @map("a_plus_plan_json") @db.Text
  rufusCoverageJson String?                 @map("rufus_coverage_json") @db.Text
  keywordCoverageJson String?               @map("keyword_coverage_json") @db.Text
  claimsJson       String?                  @map("claims_json") @db.Text
  knowledgeEvidenceJson String?             @map("knowledge_evidence_json") @db.Text
  marketplace      String?                  @default("AMAZON_US") @map("marketplace")
  locale           String?                  @default("en-US") @map("locale")
  generationSource String                   @default("AI_ASSISTED") @map("generation_source")
  createdBy        String?                  @map("created_by")
  createdAt        DateTime                 @default(now()) @map("created_at")

  listing          Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  complianceChecks ListingComplianceCheck[]

  @@unique([listingId, versionNumber])
  @@index([listingId])
  @@map("listing_versions")
}

model ListingComplianceCheck {
  id                String                      @id @default(uuid())
  listingVersionId  String                      @map("listing_version_id")
  status            String                      @default("PASS") // PASS, WARNING, REJECTED
  riskLevel         String                      @default("LOW") // LOW, MEDIUM, HIGH
  ruleHitsJson      String                      @map("rule_hits_json") @db.Text
  evidenceSummary   String                      @map("evidence_summary") @db.Text
  suggestedRevision String?                     @map("suggested_revision") @db.Text
  modelName         String                      @default("qwen3.8-max") @map("model_name")
  promptVersion     String                      @default("v1.0") @map("prompt_version")
  createdAt         DateTime                    @default(now()) @map("created_at")

  listingVersion    ListingVersion              @relation(fields: [listingVersionId], references: [id], onDelete: Cascade)
  evidences         ListingComplianceEvidence[]

  @@index([listingVersionId])
  @@map("listing_compliance_checks")
}

model ListingComplianceEvidence {
  id                String                 @id @default(uuid())
  complianceCheckId String                 @map("compliance_check_id")
  knowledgeChunkId  String?                @map("knowledge_chunk_id")
  ruleCode          String                 @map("rule_code")
  relevanceScore    Decimal                @map("relevance_score") @db.Decimal(4, 2)
  quotedEvidence    String                 @map("quoted_evidence") @db.Text
  createdAt         DateTime               @default(now()) @map("created_at")

  complianceCheck   ListingComplianceCheck @relation(fields: [complianceCheckId], references: [id], onDelete: Cascade)
  knowledgeChunk    KnowledgeChunk?        @relation(fields: [knowledgeChunkId], references: [id])

  @@index([complianceCheckId])
  @@map("listing_compliance_evidence")
}

// ==========================================
// 49. Launch 模型
// ==========================================

model LaunchPlan {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  skuId       String         @map("sku_id")
  name        String
  startDate   DateTime       @map("start_date")
  endDate     DateTime?      @map("end_date")
  status      String         @default("ACTIVE")
  goal        String         @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku         Sku            @relation(fields: [skuId], references: [id], onDelete: Cascade)
  actions     LaunchAction[]

  @@index([workspaceId])
  @@map("launch_plans")
}

model LaunchAction {
  id           String     @id @default(uuid())
  launchPlanId String     @map("launch_plan_id")
  actionType   String     @map("action_type") // PPC_BURST, PRICE_DISCOUNT, REVIEW_REQUEST, VINE_ENROLLMENT
  scheduledAt  DateTime   @map("scheduled_at")
  status       String     @default("COMPLETED")
  detailJson   String?    @map("detail_json") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  launchPlan   LaunchPlan @relation(fields: [launchPlanId], references: [id], onDelete: Cascade)

  @@index([launchPlanId])
  @@map("launch_actions")
}

// ==========================================
// 50. 广告模型
// ==========================================

enum CampaignStatus {
  ENABLED
  PAUSED
  ARCHIVED
}

model Campaign {
  id                     String                  @id @default(uuid())
  workspaceId            String                  @map("workspace_id")
  marketplaceId          String                  @map("marketplace_id")
  campaignIdAmazon       String?                 @map("campaign_id_amazon")
  name                   String
  campaignType           String                  @default("SPONSORED_PRODUCTS") @map("campaign_type")
  targetingType          String                  @default("AUTO") @map("targeting_type")
  budget                 Decimal                 @db.Decimal(10, 2)
  status                 CampaignStatus          @default(ENABLED)
  startDate              DateTime                @map("start_date")
  endDate                DateTime?               @map("end_date")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplace            Marketplace             @relation(fields: [marketplaceId], references: [id])
  campaignSkus           CampaignSku[]
  adTargets              AdTarget[]
  adMetricsDaily         AdMetricDaily[]
  searchTermMetricsDaily SearchTermMetricDaily[]

  @@index([workspaceId])
  @@map("campaigns")
}

model CampaignSku {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  skuId      String   @map("sku_id")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sku        Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([campaignId, skuId])
  @@index([campaignId])
  @@map("campaign_skus")
}

model AdTarget {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  targetType  String   @default("KEYWORD") @map("target_type") // KEYWORD, ASIN, CATEGORY
  targetValue String   @map("target_value")
  matchType   String   @default("EXACT") @map("match_type") // EXACT, PHRASE, BROAD, NEGATIVE_EXACT
  bid         Decimal  @db.Decimal(10, 2)
  status      String   @default("ENABLED")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("ad_targets")
}

model AdMetricDaily {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  skuId       String?  @map("sku_id")
  metricDate  DateTime @map("metric_date") @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(10, 2)
  orders      Int      @default(0)
  sales       Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sku         Sku?     @relation(fields: [skuId], references: [id])

  @@unique([campaignId, metricDate, skuId])
  @@index([campaignId])
  @@index([metricDate])
  @@map("ad_metrics_daily")
}

model SearchTermMetricDaily {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  skuId       String   @map("sku_id")
  searchTerm  String   @map("search_term")
  metricDate  DateTime @map("metric_date") @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(10, 2)
  orders      Int      @default(0)
  sales       Decimal  @default(0) @db.Decimal(10, 2)
  acos        Decimal  @default(0) @db.Decimal(6, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sku         Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([searchTerm])
  @@index([metricDate])
  @@map("search_term_metrics_daily")
}

// ==========================================
// 51. 订单与履约模型
// ==========================================

enum OrderStatus {
  PENDING
  UNSHIPPED
  PARTIALLY_SHIPPED
  SHIPPED
  CANCELLED
}

model Order {
  id               String      @id @default(uuid())
  workspaceId      String      @map("workspace_id")
  marketplaceId    String      @map("marketplace_id")
  orderNumber      String      @map("order_number")
  /// Partial unique with sourceAccountId+externalOrderId is in SQL:
  /// 20260912180000_epic4_store_foundation (orders_ws_account_external_uid)
  /// WHERE source_account_id IS NOT NULL AND external_order_id IS NOT NULL.
  /// Prisma cannot express partial unique indexes — do not add @@unique here.
  externalOrderId  String?     @map("external_order_id")
  sourceProvider   String?     @map("source_provider")
  sourceAccountId  String?     @map("source_account_id")
  status           OrderStatus @default(SHIPPED)
  totalAmount      Decimal     @map("total_amount") @db.Decimal(10, 2)
  currencyCode     String      @default("USD") @map("currency_code")
  orderedAt        DateTime    @map("ordered_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  marketplace      Marketplace @relation(fields: [marketplaceId], references: [id])
  items            OrderItem[]

  @@unique([workspaceId, orderNumber])
  @@index([workspaceId])
  @@index([orderedAt])
  @@index([workspaceId, externalOrderId])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  orderId     String         @map("order_id")
  skuId       String         @map("sku_id")
  quantity    Int
  unitPrice   Decimal        @map("unit_price") @db.Decimal(10, 2)
  itemTax     Decimal        @default(0) @map("item_tax") @db.Decimal(10, 2)
  shippingFee Decimal        @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  createdAt   DateTime       @default(now()) @map("created_at")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         Sku            @relation(fields: [skuId], references: [id])
  returns     ReturnRecord[]

  @@index([workspaceId])
  @@index([orderId])
  @@map("order_items")
}

// ==========================================
// 52. Inventory / FBA 模型
// ==========================================

enum WarehouseType {
  FBA
  FBM
  LOCAL_TRANSIT
}

model InventoryBalance {
  id                    String        @id @default(uuid())
  workspaceId           String        @map("workspace_id")
  skuId                 String        @map("sku_id")
  warehouseType         WarehouseType @default(FBA) @map("warehouse_type")
  fulfillableQuantity   Int           @default(0) @map("fulfillable_quantity")
  reservedQuantity      Int           @default(0) @map("reserved_quantity")
  inboundQuantity       Int           @default(0) @map("inbound_quantity")
  unfulfillableQuantity Int           @default(0) @map("unfulfillable_quantity")
  sourceUpdatedAt       DateTime?     @map("source_updated_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  workspace             Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku                   Sku           @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, skuId, warehouseType])
  @@index([workspaceId])
  @@map("inventory_balances")
}

model InventorySnapshot {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  skuId         String    @map("sku_id")
  snapshotDate  DateTime  @map("snapshot_date") @db.Date
  fulfillable   Int       @default(0)
  reserved      Int       @default(0)
  inbound       Int       @default(0)
  unfulfillable Int       @default(0)
  daysCover     Decimal?  @map("days_cover") @db.Decimal(6, 1)
  createdAt     DateTime  @default(now()) @map("created_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku           Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, snapshotDate])
  @@index([workspaceId])
  @@index([snapshotDate])
  @@map("inventory_snapshots")
}

model InventoryRecommendation {
  id                  String    @id @default(uuid())
  workspaceId         String    @map("workspace_id")
  skuId               String    @map("sku_id")
  recommendationDate  DateTime  @map("recommendation_date") @db.Date
  avgDailySales       Decimal   @map("avg_daily_sales") @db.Decimal(8, 2)
  forecastDailySales  Decimal   @map("forecast_daily_sales") @db.Decimal(8, 2)
  daysCover           Decimal   @map("days_cover") @db.Decimal(6, 1)
  leadTimeDays        Int       @map("lead_time_days")
  safetyStock         Int       @map("safety_stock")
  reorderPoint        Int       @map("reorder_point")
  recommendedQuantity Int       @map("recommended_quantity")
  riskLevel           String    @default("NORMAL") @map("risk_level") // NORMAL, WARNING, CRITICAL
  status              String    @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt           DateTime  @default(now()) @map("created_at")

  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku                 Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([skuId])
  @@map("inventory_recommendations")
}

// ==========================================
// 53. Returns 模型
// ==========================================

model ReturnRecord {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  orderItemId  String    @map("order_item_id")
  skuId        String    @map("sku_id")
  reason       String?
  status       String    @default("COMPLETED")
  refundAmount Decimal   @map("refund_amount") @db.Decimal(10, 2)
  returnDate   DateTime  @map("return_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([skuId])
  @@map("returns")
}

// ==========================================
// 54. 利润中心每日聚合模型
// ==========================================

model ProfitDaily {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  skuId       String    @map("sku_id")
  date        DateTime  @db.Date
  revenue     Decimal   @default(0) @db.Decimal(12, 2)
  cogs        Decimal   @default(0) @db.Decimal(12, 2)
  adsCost     Decimal   @default(0) @map("ads_cost") @db.Decimal(12, 2)
  amazonFees  Decimal   @default(0) @map("amazon_fees") @db.Decimal(12, 2)
  fbaFee      Decimal   @default(0) @map("fba_fee") @db.Decimal(12, 2)
  returnLoss  Decimal   @default(0) @map("return_loss") @db.Decimal(12, 2)
  otherCosts  Decimal   @default(0) @map("other_costs") @db.Decimal(12, 2)
  netProfit   Decimal   @default(0) @map("net_profit") @db.Decimal(12, 2)
  margin      Decimal   @default(0) @db.Decimal(6, 4)
  source      String    @default("ESTIMATED")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku         Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, skuId, date])
  @@index([workspaceId])
  @@index([date])
  @@map("profit_daily")
}

// ==========================================
// 55. AI Business Analyst 实体模型
// ==========================================

model AnalysisSession {
  id          String             @id @default(uuid())
  workspaceId String             @map("workspace_id")
  userId      String             @map("user_id")
  activeSkuId String?            @map("active_sku_id")
  question    String             @db.Text
  status      String             @default("COMPLETED")
  startedAt   DateTime           @default(now()) @map("started_at")
  completedAt DateTime?          @map("completed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id])
  sku         Sku?               @relation(fields: [activeSkuId], references: [id])
  findings    AnalysisFinding[]
  waterfall   AnalysisWaterfall?

  @@index([workspaceId])
  @@map("analysis_sessions")
}

model AnalysisFinding {
  id                String          @id @default(uuid())
  analysisSessionId String          @map("analysis_session_id")
  findingType       String          @map("finding_type") // ADVERTISING, RETURN, INVENTORY, PRICING, OTHER
  title             String
  metricName        String          @map("metric_name")
  impactAmount      Decimal?        @map("impact_amount") @db.Decimal(12, 2)
  direction         String          // NEGATIVE, POSITIVE
  confidence        Decimal         @db.Decimal(3, 2)
  evidenceJson      String          @map("evidence_json") @db.Text
  priority          Int             @default(1)
  recommendation    String          @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")

  session           AnalysisSession @relation(fields: [analysisSessionId], references: [id], onDelete: Cascade)

  @@index([analysisSessionId])
  @@map("analysis_findings")
}

model AnalysisWaterfall {
  id                String          @id @default(uuid())
  analysisSessionId String          @unique @map("analysis_session_id")
  periodStart       DateTime        @map("period_start") @db.Date
  periodEnd         DateTime        @map("period_end") @db.Date
  totalVariance     Decimal         @map("total_variance") @db.Decimal(12, 2)
  advertisingImpact Decimal         @map("advertising_impact") @db.Decimal(12, 2)
  returnsImpact     Decimal         @map("returns_impact") @db.Decimal(12, 2)
  inventoryImpact   Decimal         @map("inventory_impact") @db.Decimal(12, 2)
  priceImpact       Decimal         @map("price_impact") @db.Decimal(12, 2)
  otherImpact       Decimal         @map("other_impact") @db.Decimal(12, 2)
  formulaExplained  String          @map("formula_explained")
  createdAt         DateTime        @default(now()) @map("created_at")

  session           AnalysisSession @relation(fields: [analysisSessionId], references: [id], onDelete: Cascade)

  @@map("analysis_waterfalls")
}

// ==========================================
// 56. Agent Task / Workflow 实体模型
// ==========================================

model AgentTask {
  id                String          @id @default(uuid())
  workspaceId       String          @map("workspace_id")
  userId            String?         @map("user_id")
  taskType          String          @map("task_type") // LISTING_GENERATE, COMPLIANCE_CHECK, VOC_ANALYZE, VARIANCE_ATTRIBUTION, INVENTORY_PLAN, DAILY_OPERATION_WF05
  status            String          @default("COMPLETED") // PENDING, RUNNING, WAITING_APPROVAL, COMPLETED, FAILED, PARTIALLY_APPROVED, PARTIAL_SUCCESS
  activeSkuId       String?         @map("active_sku_id")
  checkpointVersion Int             @default(1) @map("checkpoint_version")
  checkpointedAt    DateTime?       @map("checkpointed_at")
  workflowVersion   String?         @default("WF05_V1") @map("workflow_version")
  currentStep       String?         @map("current_step")
  inputJson         String          @map("input_json") @db.Text
  resultJson        String?         @map("result_json") @db.Text
  errorCode         String?         @map("error_code")
  errorMessage      String?         @map("error_message")
  startedAt         DateTime        @default(now()) @map("started_at")
  completedAt       DateTime?       @map("completed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id])
  sku            Sku?            @relation(fields: [activeSkuId], references: [id])
  steps          AgentStep[]
  toolExecutions ToolExecution[]
  approvals      Approval[]

  @@index([workspaceId])
  @@index([checkpointVersion])
  @@map("agent_tasks")
}

model WorkflowIdempotency {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  scope          String
  idempotencyKey String   @map("idempotency_key")
  taskId         String   @map("task_id")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, idempotencyKey])
  @@index([taskId])
  @@index([workspaceId])
  @@map("workflow_idempotency")
}

model AgentStep {
  id             String          @id @default(uuid())
  taskId         String          @map("task_id")
  stepNumber     Int             @map("step_number")
  stepType       String          @map("step_type")
  name           String
  status         String          @default("COMPLETED")
  inputSummary   String?         @map("input_summary")
  outputSummary  String?         @map("output_summary")
  startedAt      DateTime        @default(now()) @map("started_at")
  completedAt    DateTime?       @map("completed_at")

  task           AgentTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  toolExecutions ToolExecution[]

  @@index([taskId])
  @@map("agent_steps")
}

model ToolExecution {
  id           String     @id @default(uuid())
  taskId       String     @map("task_id")
  agentStepId  String?    @map("agent_step_id")
  toolName     String     @map("tool_name")
  inputJson    String     @map("input_json") @db.Text
  outputJson   String     @map("output_json") @db.Text
  status       String     @default("SUCCESS")
  latencyMs    Int        @map("latency_ms")
  errorMessage String?    @map("error_message")
  createdAt    DateTime   @default(now()) @map("created_at")

  task         AgentTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  step         AgentStep? @relation(fields: [agentStepId], references: [id])

  @@index([taskId])
  @@map("tool_executions")
}

// ==========================================
// 57. HITL / Approval 模型
// ==========================================

model Approval {
  id               String     @id @default(uuid())
  workspaceId      String     @map("workspace_id")
  taskId           String?    @map("task_id")
  actionType       String     @map("action_type") // LISTING_PUBLISH, PO_SUBMIT, NEGATIVE_KEYWORD_ADD, PRICE_CHANGE
  targetType       String     @map("target_type")
  targetId         String     @map("target_id")
  requestedPayload String     @map("requested_payload") @db.Text
  status           String     @default("PENDING") // PENDING, APPROVED, REJECTED, DISMISSED
  requestedBy      String     @map("requested_by")
  approvedBy       String?    @map("approved_by")
  requestedAt      DateTime   @default(now()) @map("requested_at")
  resolvedAt       DateTime?  @map("resolved_at")
  comment          String?

  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task             AgentTask? @relation(fields: [taskId], references: [id])

  @@index([workspaceId])
  @@map("approvals")
}

// ==========================================
// 58. Knowledge / RAG 实体模型
// ==========================================

model KnowledgeDocument {
  id           String           @id @default(uuid())
  workspaceId  String?          @map("workspace_id")
  documentType String           @map("document_type") // AMAZON_POLICY, PRODUCT_KNOWLEDGE
  title        String
  source       String
  version      String           @default("1.0")
  status       String           @default("INDEXED")
  filePath     String?          @map("file_path")
  createdAt    DateTime         @default(now()) @map("created_at")

  workspace    Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id                         String                      @id @default(uuid())
  documentId                 String                      @map("document_id")
  chunkIndex                 Int                         @map("chunk_index")
  content                    String                      @db.Text
  tokenCount                 Int                         @map("token_count")
  metadataJson               String?                     @map("metadata_json") @db.Text
  embeddingStatus            String                      @default("INDEXED") @map("embedding_status")
  createdAt                  DateTime                    @default(now()) @map("created_at")

  document                   KnowledgeDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  listingComplianceEvidences ListingComplianceEvidence[]

  @@index([documentId])
  @@map("knowledge_chunks")
}

// ==========================================
// 59. Eval / Quality 实体模型
// ==========================================

model EvalDataset {
  id          String      @id @default(uuid())
  workspaceId String      @map("workspace_id")
  name        String
  taskType    String      @map("task_type")
  version     String      @default("1.0")
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cases       EvalCase[]
  runs        EvalRun[]

  @@index([workspaceId])
  @@map("eval_datasets")
}

model EvalCase {
  id           String       @id @default(uuid())
  datasetId    String       @map("dataset_id")
  inputJson    String       @map("input_json") @db.Text
  expectedJson String       @map("expected_json") @db.Text
  metadataJson String?      @map("metadata_json") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")

  dataset      EvalDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results      EvalResult[]

  @@index([datasetId])
  @@map("eval_cases")
}

model EvalRun {
  id              String       @id @default(uuid())
  datasetId       String       @map("dataset_id")
  modelName       String       @map("model_name")
  promptVersion   String       @map("prompt_version")
  workflowVersion String       @map("workflow_version")
  status          String       @default("COMPLETED")
  startedAt       DateTime     @default(now()) @map("started_at")
  completedAt     DateTime?    @map("completed_at")

  dataset         EvalDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results         EvalResult[]

  @@index([datasetId])
  @@map("eval_runs")
}

model EvalResult {
  id         String   @id @default(uuid())
  evalRunId  String   @map("eval_run_id")
  evalCaseId String   @map("eval_case_id")
  metricName String   @map("metric_name")
  score      Decimal  @db.Decimal(5, 4)
  passed     Boolean  @default(true)
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  evalRun    EvalRun  @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  evalCase   EvalCase @relation(fields: [evalCaseId], references: [id], onDelete: Cascade)

  @@index([evalRunId])
  @@index([evalCaseId])
  @@map("eval_results")
}

// ==========================================
// V10 Epic 1 — Store + ChannelIdentity foundation
// Canonical tables stay free of amazonId / shopifyId columns.
// ==========================================

model Store {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  platform    String
  country     String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts    CommerceAccount[]
  identities  ChannelIdentity[]
  simulationRuns          SimulationRun[]
  simulationLedgerEntries SimulationLedgerEntry[]

  @@index([workspaceId])
  @@index([workspaceId, platform])
  @@map("stores")
}

model ChannelIdentity {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  platform   String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  externalId String   @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")

  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, platform, entityType, externalId])
  @@index([storeId])
  @@index([entityType, entityId])
  @@map("channel_identities")
}

// ==========================================
// Epic 4 — Real Store Data Foundation (additive)
// ==========================================

model CommerceAccount {
  id                     String               @id @default(uuid())
  workspaceId            String               @map("workspace_id")
  storeId                String               @unique @map("store_id")
  provider               String               @default("amazon")
  sellingPartnerId       String?              @map("selling_partner_id")
  region                 String               @default("NA")
  status                 String               @default("DISCONNECTED")
  defaultMarketplaceCode String?              @map("default_marketplace_code")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  workspace              Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  store                  Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  credentials            ProviderCredential[]
  syncRuns               SyncRun[]

  @@index([workspaceId])
  @@index([workspaceId, provider])
  @@map("commerce_accounts")
}

model ProviderCredential {
  id        String          @id @default(uuid())
  accountId String          @map("account_id")
  kind      String
  payloadEnc String         @map("payload_enc") @db.Text
  expiresAt DateTime?       @map("expires_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  account   CommerceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind])
  @@index([accountId])
  @@map("provider_credentials")
}

model SyncRun {
  id                String           @id @default(uuid())
  workspaceId       String           @map("workspace_id")
  accountId         String           @map("account_id")
  capability        String
  status            String           @default("RUNNING")
  cursor            String?
  startedAt         DateTime         @default(now()) @map("started_at")
  completedAt       DateTime?        @map("completed_at")
  recordsProcessed  Int              @default(0) @map("records_processed")
  recordsFailed     Int              @default(0) @map("records_failed")
  errorCode         String?          @map("error_code")
  durationMs        Int?             @map("duration_ms")

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account           CommerceAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([accountId])
  @@index([startedAt])
  @@map("sync_runs")
}

// ==========================================
// V9.2 Phase 1 — Playbook Framework (additive)
// Execution state lives on PlaybookRun, never on Playbook.
// ==========================================

model Playbook {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  version     String
  status      String   @default("REGISTERED")
  inputSchema Json     @map("input_schema")
  outputSchema Json    @map("output_schema")
  definition  Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        PlaybookRun[]

  @@unique([workspaceId, name, version])
  @@index([workspaceId])
  @@map("playbooks")
}

model PlaybookRun {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  playbookId  String   @map("playbook_id")
  runId       String   @unique @map("run_id")
  status      String   @default("CREATED")
  input       Json
  output      Json?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  playbook    Playbook  @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([playbookId])
  @@map("playbook_runs")
}

// ==========================================
// V9.2 Phase 2–5 — Fact / Evidence / Recommendation
// ==========================================

model CommerceFact {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  factType        String   @map("fact_type")
  metric          String
  valueJson       Json     @map("value_json")
  sourceProvider  String   @map("source_provider")
  sourceReference String   @map("source_reference")
  observedAt      DateTime @map("observed_at")
  playbookRunId   String?  @map("playbook_run_id")
  createdAt       DateTime @default(now()) @map("created_at")

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence        EvidenceItem[]

  @@index([workspaceId])
  @@index([playbookRunId])
  @@map("commerce_facts")
}

model EvidenceItem {
  id            String   @id @default(uuid())
  workspaceId   String   @map("workspace_id")
  factId        String   @map("fact_id")
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id")
  quote         String   @db.Text
  confidence    Decimal  @db.Decimal(5, 4)
  playbookRunId String?  @map("playbook_run_id")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fact          CommerceFact  @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([factId])
  @@map("evidence_items")
}

model BusinessRecommendation {
  id                   String   @id @default(uuid())
  workspaceId          String   @map("workspace_id")
  decision             String
  reason               String   @db.Text
  confidence           Decimal  @db.Decimal(5, 4)
  evidenceIds          Json     @map("evidence_ids")
  status               String   @default("GENERATED")
  playbookRunId        String?  @map("playbook_run_id")
  executionDispatched  Boolean  @default(false) @map("execution_dispatched")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plannedActions       PlannedAction[]

  @@index([workspaceId])
  @@index([status])
  @@map("business_recommendations")
}

// ==========================================
// V9.3 Action Layer — planned mock execution
// Recommendation answers why; PlannedAction answers what to run.
// ==========================================

model PlannedAction {
  id               String   @id @default(uuid())
  workspaceId      String   @map("workspace_id")
  recommendationId String?  @map("recommendation_id")
  actionType       String   @map("action_type")
  target           Json
  parameters       Json
  riskLevel        String   @map("risk_level")
  needApproval     Boolean  @default(true) @map("need_approval")
  status           String   @default("CREATED")
  lastMessage      String?  @map("last_message") @db.Text
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recommendation   BusinessRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  executions       ActionExecution[]
  outcomes         ActionOutcome[]
  simulationReceipts SimulationExecutionReceipt[]

  @@index([workspaceId])
  @@index([recommendationId])
  @@index([status])
  @@map("planned_actions")
}

model ActionExecution {
  id        String   @id @default(uuid())
  workspaceId String @map("workspace_id")
  actionId  String   @map("action_id")
  operator  String
  timestamp DateTime @default(now())
  input     Json
  output    Json?
  status    String
  error     String?  @db.Text
  attempt   Int      @default(1)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  action    PlannedAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([actionId])
  @@map("action_executions")
}

// ==========================================
// V10 Epic A — Outcome Tracking（additive）
// Action 执行后 7/14/30 天观察窗的 Before/After 指标对比与确定性判定。
// 时间基准：workspace 有 simulation_states 行时「今天」= sim_date，否则宿主机当天。
// ==========================================

model ActionOutcome {
  id               String    @id @default(uuid())
  workspaceId      String    @map("workspace_id")
  actionId         String    @map("action_id")
  storeId          String?   @map("store_id")
  targetType       String    @map("target_type")
  targetId         String    @map("target_id")

  baselineStart    DateTime  @map("baseline_start") @db.Date
  baselineEnd      DateTime  @map("baseline_end") @db.Date
  observeStart     DateTime  @map("observe_start") @db.Date
  observeEnd       DateTime  @map("observe_end") @db.Date

  windowDays       Int       @map("window_days")
  metricsBefore    Json      @map("metrics_before")
  metricsAfter     Json?     @map("metrics_after")
  delta            Json?

  status               String    @default("OBSERVING")
  evaluationReason     String?   @map("evaluation_reason") @db.Text
  evaluationVersion    String    @default("legacy-v1") @map("evaluation_version")
  interventionVerified Boolean   @default(false) @map("intervention_verified")
  dataCoverage         Json?     @map("data_coverage")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  evaluatedAt      DateTime? @map("evaluated_at")

  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  action           PlannedAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, windowDays])
  @@index([workspaceId, status])
  @@index([observeEnd])
  @@map("action_outcomes")
}

// ==========================================
// Commerce Simulator（docs/40_mockData）
// 模拟经营世界：时钟状态 / 业务事件 / 渠道日指标
// ==========================================

model SimulationState {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  simDate     DateTime @map("sim_date") @db.Date
  dayIndex    Int      @default(0) @map("day_index")
  status      String   @default("RUNNING")
  config      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@map("simulation_states")
}

model SimulationEvent {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  skuId       String?  @map("sku_id")
  simDate     DateTime @map("sim_date") @db.Date
  code        String
  severity    String   @default("INFO") // INFO | WARNING | CRITICAL
  title       String
  description String   @db.Text
  status      String   @default("ACTIVE") // ACTIVE | RESOLVED | COMPLETED
  createdAt   DateTime @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku         Sku?      @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([simDate])
  @@map("simulation_events")
}

model ChannelDailyMetric {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  skuId          String   @map("sku_id")
  channel        String // amazon | shopify
  metricDate     DateTime @map("metric_date") @db.Date
  sessions       Int      @default(0)
  addToCart      Int      @default(0) @map("add_to_cart")
  checkout       Int      @default(0)
  orders         Int      @default(0)
  conversionRate Decimal  @default(0) @map("conversion_rate") @db.Decimal(6, 4)
  bounceRate     Decimal  @default(0) @map("bounce_rate") @db.Decimal(6, 4)
  revenue        Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sku            Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channel, skuId, metricDate])
  @@index([workspaceId])
  @@index([metricDate])
  @@map("channel_daily_metrics")
}

// ==========================================
// Simulator closed-loop-v2 (docs/00_governance/more)
// ==========================================

model SimulationRun {
  id                 String    @id @default(uuid())
  controlWorkspaceId String    @map("control_workspace_id")
  runWorkspaceId     String    @unique @map("run_workspace_id")
  storeId            String    @map("store_id")
  modelVersion       String    @default("closed-loop-v2") @map("model_version")
  configHash         String    @map("config_hash")
  seed               Int       @default(1001)
  status             String    @default("RUNNING") // RUNNING | PAUSED | COMPLETED | FAILED
  completedThrough   DateTime? @map("completed_through") @db.Date
  parentExperimentId String?   @map("parent_experiment_id")
  stateSnapshot      Json?     @map("state_snapshot")
  config             Json?     @map("config")
  policyEnabled      Boolean   @default(false) @map("policy_enabled")
  policyLimits       Json?     @map("policy_limits")
  idempotencyKey     String?   @unique @map("idempotency_key")
  stateVersion       Int       @default(1) @map("state_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  controlWorkspace   Workspace                  @relation("ControlWorkspaceRuns", fields: [controlWorkspaceId], references: [id], onDelete: Cascade)
  runWorkspace       Workspace                  @relation("RunWorkspaceRuns", fields: [runWorkspaceId], references: [id], onDelete: Cascade)
  store              Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentExperiment   SimulationExperiment?      @relation("ExperimentRuns", fields: [parentExperimentId], references: [id], onDelete: SetNull)
  ticks              SimulationTick[]
  receipts           SimulationExecutionReceipt[]
  ledgerEntries      SimulationLedgerEntry[]

  @@index([controlWorkspaceId])
  @@index([status])
  @@map("simulation_runs")
}

model SimulationTick {
  id           String   @id @default(uuid())
  runId        String   @map("run_id")
  date         DateTime @db.Date
  inputHash    String   @map("input_hash")
  outputHash   String   @map("output_hash")
  stateVersion Int      @default(1) @map("state_version")
  status       String   @default("COMMITTED") // COMMITTED | FAILED | ROLLING_BACK
  summary      Json?
  completedAt  DateTime @default(now()) @map("completed_at")

  run          SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, date])
  @@index([runId])
  @@map("simulation_ticks")
}

model SimulationExecutionReceipt {
  id            String   @id @default(uuid())
  runId         String   @map("run_id")
  actionId      String   @map("action_id")
  operationKind String   @default("APPLY") @map("operation_kind") // APPLY | COMPENSATE
  payloadHash   String   @map("payload_hash")
  appliedDate   DateTime @map("applied_date") @db.Date
  targetVersion Int      @map("target_version")
  status        String   @default("APPLIED") // PENDING | APPLIED | NOT_APPLIED | UNKNOWN
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  attempt       Int      @default(1)
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  run           SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  action        PlannedAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([runId, actionId, operationKind])
  @@index([runId])
  @@index([actionId])
  @@map("simulation_execution_receipts")
}

model SimulationLedgerEntry {
  id                String   @id @default(uuid())
  runId             String   @map("run_id")
  storeId           String   @map("store_id")
  date              DateTime @db.Date
  sourceType        String   @map("source_type") // ORDER | AD_DAILY | REFUND | FEE | EVENT
  sourceId          String   @map("source_id")
  entryType         String   @map("entry_type") // REVENUE | COGS | AD_SPEND | PLATFORM_FEE | FULFILLMENT_FEE | STORAGE_FEE | RETURN_REFUND | COGS_REVERSAL | AI_COST
  sequence          Int      @default(0)
  signedAmountCents Int      @map("signed_amount_cents")
  currency          String   @default("USD")
  description       String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  run               SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  store             Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([runId, date, sourceType, sourceId, entryType, sequence])
  @@index([runId, date])
  @@map("simulation_ledger_entries")
}

model SimulationExperiment {
  id                 String   @id @default(uuid())
  controlWorkspaceId String   @map("control_workspace_id")
  name               String
  scenarioManifest   Json     @map("scenario_manifest")
  seedManifest       Json     @map("seed_manifest")
  manifestHash       String   @map("manifest_hash")
  policyVersion      String   @default("v1.0.0") @map("policy_version")
  evaluationVersion  String   @default("closed-loop-v2") @map("evaluation_version")
  status             String   @default("RUNNING") // RUNNING | COMPLETED | PAUSED_BUDGET | FAILED
  controlRunId       String?  @map("control_run_id")
  ruleRunId          String?  @map("rule_run_id")
  crossPilotRunId    String?  @map("cross_pilot_run_id")
  results            Json?    @map("results")
  artifacts          Json?    @map("artifacts")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  controlWorkspace   Workspace       @relation("ControlWorkspaceExperiments", fields: [controlWorkspaceId], references: [id], onDelete: Cascade)
  runs               SimulationRun[] @relation("ExperimentRuns")

  @@index([controlWorkspaceId])
  @@map("simulation_experiments")
}

