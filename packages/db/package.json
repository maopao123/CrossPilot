    "test": "echo \"Database package types verified\""
  },
  "dependencies": {
    "@crosspilot/domain": "workspace:*",
    "@prisma/client": "^6.3.1",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.5",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
