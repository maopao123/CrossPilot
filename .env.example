# CrossPilot Environment Variables Configuration

# Node Environment
NODE_ENV=development

# Server Ports
PORT=3001
API_PORT=3001
WORKER_PORT=3002
WEB_PORT=3000

# Base URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crosspilot?schema=public

# Redis Configuration (BullMQ, Cache, PubSub)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Milvus Vector Database
MILVUS_ADDRESS=localhost:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

# Security & Auth
SESSION_SECRET=crosspilot_super_secure_session_secret_change_me_in_production
JWT_SECRET=crosspilot_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Demo Mode
DEMO_MODE=true

# AI Provider Settings (Reserved for later milestones)
LLM_PROVIDER=openai
LLM_API_KEY=mock-key-for-development
LLM_MODEL=gpt-4o-mini

# Amazon SP-API (optional — app starts without these; Epic 4 read-only)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REDIRECT_URI=http://localhost:3001/api/v1/commerce/amazon/oauth/callback
AMAZON_APPLICATION_ID=
AMAZON_CREDENTIAL_ENCRYPTION_KEY=
AMAZON_SP_API_REGION=NA
STORE_SKU360_SOURCE=scenario
# Commerce Simulator (docs/40_mockData) — worker 定时推进模拟日
SIMULATOR_ENABLED=false
SIMULATOR_TICK_INTERVAL_MINUTES=60
